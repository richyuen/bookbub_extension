{
  "manifest_version": 3,
  "name": "Book Deal Auto-Claimer",
  "version": "1.0.0",
  "description": "Unofficial: claims free ebook deals from BookBub deal pages using Amazon 1-Click. Requires Amazon 1-Click enabled.",
  "permissions": [
    "storage"
  ],
  "host_permissions": [
    "https://www.bookbub.com/*",
    "https://www.amazon.com/*"
  ],
  "background": {
    "service_worker": "background.js"
  },
  "content_scripts": [
    {
      "matches": ["https://www.bookbub.com/*"],
      "js": ["content/bookbub.js"],
      "run_at": "document_idle"
    },
    {
      "matches": ["https://www.amazon.com/*"],
      "js": ["content/amazon.js"],
      "run_at": "document_idle"
    }
  ],
  "action": {
    "default_popup": "popup/popup.html",
    "default_icon": {
      "16": "icons/icon16.png",
      "48": "icons/icon48.png",
      "128": "icons/icon128.png"
    }
  },
  "icons": {
    "16": "icons/icon16.png",
    "48": "icons/icon48.png",
    "128": "icons/icon128.png"
  }
}
